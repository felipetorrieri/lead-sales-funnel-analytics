-- Create these measures in Power BI after importing data/leads_synthetic.csv

Leads =
COUNTROWS(leads)

Pedidos =
SUM(leads[is_order])

Aprovados =
SUM(leads[is_approved])

Formalizados =
SUM(leads[is_formalized])

Assinados =
SUM(leads[is_signed])

GMV =
SUM(leads[gmv])

Valor Pago =
SUM(leads[amount_paid])

Conversão Lead → Pedido =
DIVIDE([Pedidos], [Leads])

Conversão Pedido → Aprovado =
DIVIDE([Aprovados], [Pedidos])

Conversão Aprovado → Formalizado =
DIVIDE([Formalizados], [Aprovados])

Conversão Formalizado → Assinado =
DIVIDE([Assinados], [Formalizados])

Conversão Geral =
DIVIDE([Assinados], [Leads])

Meta Formalizados =
SUM(leads[target_formalized])

Meta Assinados =
SUM(leads[target_signed])

% Meta Formalizados =
DIVIDE([Formalizados], [Meta Formalizados])

% Meta Assinados =
DIVIDE([Assinados], [Meta Assinados])
